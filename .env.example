# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Instagram (Meta Graph API)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# TikTok (TikTok Content Posting API)
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_OPEN_ID=your_tiktok_open_id

# YouTube (Google API)
YOUTUBE_CLIENT_ID=your_google_client_id
YOUTUBE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
YOUTUBE_CHANNEL_ID=your_youtube_channel_id

# Scheduler
# Posting days: comma-separated (0=Monday,...,6=Sunday)
POSTING_DAYS=1,3,5
# Posting time in UTC (HH:MM)
POSTING_TIME_UTC=09:00

# Content settings (de=German, en=English)
CONTENT_LANGUAGE=de
# Target country for tax laws
TAX_JURISDICTION=DE

# Database
DATABASE_URL=sqlite:///tax_content.db
